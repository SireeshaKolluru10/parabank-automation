	"item": [
		{
			"name": "Login API",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"var responseXml = xml2Json(pm.response.text());\r",
							"\r",
							"pm.test(\"Customer ID is correct\", function () {\r",
							"    pm.expect(Number(responseXml.customer.id))\r",
							"        .to.eql(12212);\r",
							"});\r",
							"\r",
							"pm.test(\"First name is John\", function () {\r",
							"    pm.expect(responseXml.customer.firstName)\r",
							"        .to.eql(\"John\");\r",
							"});\r",
							"\r",
							"pm.test(\"Response time is less than 10 seconds\", function () {\r",
							"    pm.expect(pm.response.responseTime)\r",
							"        .to.be.below(10000);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://parabank.parasoft.com/parabank/services/bank/login/john/demo",
					"protocol": "https",
					"host": [
						"parabank",
						"parasoft",
						"com"
					],
					"path": [
						"parabank",
						"services",
						"bank",
						"login",
						"john",
						"demo"
					]
				}
			},
			"response": []
		},
